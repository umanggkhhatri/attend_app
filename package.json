{
  "name": "oneattend", "version": "0.1.0", "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "npm run dev -w @oneattend/web",
    "mobile": "npm run start -w @oneattend/mobile",
    "build:web": "npm run build -w @oneattend/web",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/mobile",
    "test": "tsx --test packages/core/tests/*.test.ts",
    "seed:sql": "tsx scripts/seed.ts"
  },
  "devDependencies": { "typescript": "^5.9.3", "tsx": "^4.20.0", "@types/node": "^24.0.0" }
}
