{
  "expo": {
    "name": "OneAttend",
    "slug": "oneattend",
    "version": "0.1.0",
    "scheme": "oneattend",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#191c22",
    "platforms": ["android", "web"],
    "icon": "./assets/icon.png",
    "android": {
      "package": "in.oneattend.demo",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#191c22",
        "foregroundImage": "./assets/adaptive.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "OneAttend uses your camera to scan classroom attendance QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OneAttend checks your location only while verifying classroom attendance.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191c22",
          "image": "./assets/icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-system-ui"
    ],
    "web": {
      "bundler": "metro",
      "name": "OneAttend Student Preview",
      "themeColor": "#191c22"
    },
    "extra": {
      "eas": {
        "projectId": "f4349216-ff55-447d-88d5-0d88c65646cc"
      }
    },
    "owner": "theumangkhatri"
  }
}
